# Copy this file to .env and fill in real values. NEVER commit .env
PORT=5000
NODE_ENV=development

# MongoDB Atlas -> Connect -> Drivers -> copy string, replace <password>
# Change the database name per project, e.g. /codealpha_ecommerce, /codealpha_social
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/codealpha_app?retryWrites=true&w=majority

# Any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=30d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
